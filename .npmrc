auto-install-peers=false
strict-peer-dependencies=false

# Hoist expo and react-native packages to the workspace root so EAS build
# can find the expo CLI when running from the monorepo root.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*@expo*
public-hoist-pattern[]=react-native
public-hoist-pattern[]=*react-native*
