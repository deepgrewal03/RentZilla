modules = ["nodejs-20", "nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["u-root-cmds"]

[userenv]

[userenv.shared]
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SUPPORT_EMAIL = "info.rentzilla@gmail.com"
SMTP_FROM = "RentZilla Support <info.rentzilla@gmail.com>"
EXPO_PUBLIC_GOOGLE_CLIENT_ID = "558670008629-hccacctug6of58c0627hq7qht378iunr.apps.googleusercontent.com"
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID = "558670008629-59n7mukqgqumk1cng7dlsrp45s0cohrb.apps.googleusercontent.com"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18115
externalPort = 80

[[ports]]
localPort = 20130
externalPort = 3000
