{
  "expo": {
    "name": "RentZilla",
    "slug": "rentzilla",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rentzilla",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://rent-organizer.replit.app",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF7A18"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rentzilla.app",
      "infoPlist": {
        "NSCameraUsageDescription": "RentZilla needs camera access to take your profile photo.",
        "NSPhotoLibraryUsageDescription": "RentZilla needs photo library access to set your profile picture.",
        "NSPhotoLibraryAddUsageDescription": "RentZilla needs access to save photos to your library."
      }
    },
    "android": {
      "package": "com.rentzilla.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FF7A18"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rent-organizer.replit.app"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "RentZilla needs access to your photos to set your profile picture.",
          "cameraPermission": "RentZilla needs camera access to take your profile photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
