{
  "expo": {
    "name": "RentZilla",
    "slug": "rentzilla",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rentzilla",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/975587e1-7c61-42ae-8995-b1c34641c478",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF7A18"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rentzilla.app",
      "buildNumber": "16",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "RentZilla needs camera access to take your profile photo.",
        "NSPhotoLibraryUsageDescription": "RentZilla needs photo library access to set your profile picture.",
        "NSPhotoLibraryAddUsageDescription": "RentZilla needs access to save photos to your library.",
        "NSLocationWhenInUseUsageDescription": "RentZilla uses your location to auto-fill your service address and show nearby listings.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "RentZilla uses your location to show nearby listings.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rentzilla.app",
      "versionCode": 16,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FF7A18"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rent-organizer.replit.app"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "RentZilla needs access to your photos to set your profile picture.",
          "cameraPermission": "RentZilla needs camera access to take your profile photo."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RentZilla uses your location to auto-fill your service address and show nearby listings."
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "975587e1-7c61-42ae-8995-b1c34641c478"
      }
    }
  }
}
